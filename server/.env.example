# Railway / Node server env. Set these in Railway → Project → Variables.
# All values stay server-side; never set EXPO_PUBLIC_ prefixes here.

# Supabase (server-side use — anon key reads JWT, service-role does trusted writes)
SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# AI provider (pick one)
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_API_KEY=sk-ant-...
# OR
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Stripe — secret + webhook live here, NEVER in the mobile EXPO_PUBLIC_* env.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs created in the Stripe dashboard.
# Single: £1.99 one-off → mode=payment
# Monthly: £7.99/month subscription → mode=subscription
STRIPE_PRICE_SINGLE=price_...
STRIPE_PRICE_MONTHLY=price_...

# Networking — Railway injects PORT automatically; HOST defaults to 0.0.0.0.
PORT=3000
HOST=0.0.0.0
