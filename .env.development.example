# Development build env — load with: cp .env.development.example .env
# Client-bundled values must be prefixed EXPO_PUBLIC_ to be visible at runtime.

APP_DISPLAY_NAME=AuraLens Dev
APP_SLUG=auralens
IOS_BUNDLE_ID=com.vybstak.auralens.dev
ANDROID_PACKAGE=com.vybstak.auralens.dev
EAS_PROJECT_ID=

# Supabase (optional in dev — leave empty to run fully local)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (optional in dev — leave empty to use simulated purchases)
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=

# AI Buddy LLM keys belong on the edge function (`supabase secrets set …`),
# NEVER on the device.
