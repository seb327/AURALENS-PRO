# Preview build env (internal testers). All fields must be filled in.

APP_DISPLAY_NAME=AuraLens Preview
APP_SLUG=auralens
IOS_BUNDLE_ID=com.vybstak.auralens.preview
ANDROID_PACKAGE=com.vybstak.auralens.preview
EAS_PROJECT_ID=

EXPO_PUBLIC_SUPABASE_URL=https://your-preview-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# RevenueCat preview entitlements should point at a separate RC project
# (or environment) from production so test purchases don't pollute analytics.
REVENUECAT_IOS_KEY=appl_preview_xxx
REVENUECAT_ANDROID_KEY=goog_preview_xxx
