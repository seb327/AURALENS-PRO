APP_DISPLAY_NAME=AuraLens
APP_SLUG=auralens
IOS_BUNDLE_ID=com.vybstak.auralens
ANDROID_PACKAGE=com.vybstak.auralens
EAS_PROJECT_ID=

# RevenueCat (Phase 2.2)
# Public SDK keys from https://app.revenuecat.com → API keys
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=

# Supabase (Phase 2.3)
# Project URL and anon key from https://app.supabase.com → Project Settings → API
# Leave blank to keep AuraLens fully local-first.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI Aura Buddy (Phase 2.4)
# These are EDGE FUNCTION secrets — set them via:
#   supabase secrets set AI_PROVIDER=anthropic ANTHROPIC_API_KEY=sk-ant-... AI_MODEL=claude-3-5-sonnet-latest
# AI_PROVIDER: anthropic | openai
# AI_MODEL:    optional — defaults to claude-3-5-sonnet-latest (Anthropic) or gpt-4o-mini (OpenAI)
# If neither key is set the function returns a deterministic local-fallback response.
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
